# Flap 内盘狙击后端环境变量（部署到服务器时按实际填写）
# 绝对不要填写真实私钥

# ── 链 ──
CHAIN_ID=56
RPC_HTTP_URL=https://bsc-dataseed1.bnbchain.org
BACKUP_RPC_HTTP_URL=https://bsc-dataseed.binance.org
RPC_WS_URL=wss://bsc-ws-node.nariber.org
BACKUP_RPC_WS_URL=wss://bsc.publicnode.com
LOGS_RPC_URL=https://bsc.mytokenpocket.vip

# ── Flap 合约（主网，官方部署，见 server/sniper/config.mjs） ──
FLAP_PORTAL_ADDRESS=0xe2cE6ab80874Fa9Fa2aAE65D277Dd6B8e65C9De0
FLAP_TAX_V3_IMPL=0x024f18294970B5c76c0691b87f138A0317156422
PCS_V2_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
PCS_V2_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# ── 服务 ──
SNIPER_PORT=3001
SNIPER_CORS_ORIGIN=https://monkeycoin.top
DATABASE_URL=file:server/sniper/data/flap-sniper.db

# ── 平台手续费（后端唯一权威，前端不可覆盖地址/比例/金额） ──
SNIPER_FEE_BPS=50
SNIPER_FEE_RECIPIENT=0x436fB3245Ad8377DF443Ca1c67f997705D5843bb

# ── 交易安全（默认 Dry Run，绝不自动上主网） ──
DRY_RUN=true
ENABLE_LIVE_TRADING=false
# 快速狙击：true 时不等待区块确认，命中即触发；false 走安全回溯（补漏）
FAST_SNIPER=false
BLOCK_CONFIRMATIONS=3

# ── Gas ──
AUTO_GAS=true
GAS_MULTIPLIER=1.2
MAX_GAS_PRICE_GWEI=8
BUY_GAS_LIMIT=1200000
SELL_GAS_LIMIT=1000000
TRANSACTION_DEADLINE_SECONDS=30

# ── 风控 ──
MAX_SLIPPAGE_BPS=500
MAX_BUY_AMOUNT_BNB=0.05
DAILY_BUY_LIMIT_BNB=0.5
DAILY_LOSS_LIMIT_BNB=0.2
MAX_POSITIONS=10

# ── 自动执行钱包（模式B，默认关闭；开启需配 64 位 hex 主密钥，与密文分离存放） ──
ENABLE_AUTO_WALLETS=false
WALLET_VAULT_MASTER_KEY_HEX=
WALLET_MAX_BALANCE_BNB=0.2
